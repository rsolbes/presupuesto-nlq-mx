# Copiar este archivo a .env y completar los valores.
# .env esta en .gitignore: nunca se versiona ni se comparte.

# Conexion comun.
PGHOST=localhost
PGPORT=5432
PGDATABASE=presupuesto_nlq

# Administrador: lo usan la carga y el mantenimiento. Lee y escribe.
PGUSER=
PGPASSWORD=

# Rol de consulta: lo usan el sistema y las pruebas de seguridad.
# Solo lectura, solo vistas. Ver src/sql/03_rol_consulta.sql.
CONSULTA_PGUSER=consulta_nlq
CONSULTA_PGPASSWORD=
